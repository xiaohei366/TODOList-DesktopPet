{
  "name": "todolist-desktop-pet",
  "version": "0.5.5",
  "description": "A Windows/macOS desktop pet TODOList app compatible with Codex pet packages.",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"const fs=require('node:fs'),p=require('node:path');if(fs.existsSync('release')){for(const f of fs.readdirSync('release')){try{fs.rmSync(p.join('release',f),{recursive:true,force:true})}catch{}}}\"",
    "clean:release": "node -e \"const fs=require('node:fs'),path=require('node:path');if(fs.existsSync('release')){for(const name of fs.readdirSync('release')){if(!name.endsWith('.exe')&&!name.endsWith('.dmg'))fs.rmSync(path.join('release',name),{recursive:true,force:true});}}\"",
    "kill-app": "node scripts/kill-app.cjs",
    "build": "node scripts/build.cjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "electron-updater": "^6.6.2",
    "jszip": "^3.10.1",
    "lucide-react": "^1.14.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "jsdom": "^27.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.0.15"
  },
  "build": {
    "appId": "local.todolist.desktoppet",
    "productName": "TOList Desktop Pet",
    "directories": {
      "output": "release"
    },
    "artifactName": "TOList-Desktop-Pet-${version}.${ext}",
    "files": [
      "out/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "icon": "build/icon.png",
      "target": [
        "portable"
      ]
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "13.0",
      "identity": "-",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "LSUIElement": true
      }
    }
  }
}
